{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LEVEL UP NEXUS",
  "version": "0.1.2",
  "identifier": "com.levelup.nexus",
  "build": {
    "beforeDevCommand": "pnpm dev:static",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build:static",
    "frontendDist": "../dist/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LEVEL UP NEXUS",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' asset: http://asset.localhost",
        "script-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "frame-ancestors": "'none'"
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/nexus-icon.png"
    ],
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/aria2c",
      "binaries/ffmpeg"
    ]
  }
}
