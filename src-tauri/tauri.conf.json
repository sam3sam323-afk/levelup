{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LEVEL UP NEXUS",
  "version": "0.1.0",
  "identifier": "com.levelup.nexus",
  "build": {
    "beforeDevCommand": "pnpm dev:static",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build:static",
    "frontendDist": "../dist/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LEVEL UP NEXUS",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/nexus-icon.png"],
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/aria2c",
      "binaries/ffmpeg"
    ]
  }
}
