{
  "$schema": "https://schema.tauri.app/schemas/2/capability.json",
  "identifier": "main-capability",
  "description": "Minimal permissions for the LEVEL UP NEXUS desktop shell.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "binaries/yt-dlp", "sidecar": true, "args": true },
        { "name": "binaries/aria2c", "sidecar": true, "args": true }
      ]
    }
  ]
}
