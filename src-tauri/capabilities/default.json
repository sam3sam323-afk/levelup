{
  "$schema": "https://schema.tauri.app/schemas/2/capability.json",
  "identifier": "main-capability",
  "description": "Minimal permissions for the LEVEL UP NEXUS desktop shell.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus",
    "core:window:allow-get-all-windows",
    "core:window:allow-close",
    "allow-start-download",
    "allow-pause-download",
    "allow-resume-download",
    "allow-cancel-download",
    "allow-remove-download",
    "allow-get-download",
    "allow-list-downloads",
    "allow-get-default-download-dir",
    "allow-get-engine-status",
    "allow-get-system-drives",
    "clipboard-manager:allow-read-text",
    "allow-open-file-location",
    "allow-open-browser-window",
    "allow-list-browser-tabs",
    "allow-restore-browser-tabs",
    "allow-focus-browser-tab",
    "allow-close-browser-tab",
    "store:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "binaries/yt-dlp", "sidecar": true, "args": true },
        { "name": "binaries/aria2c", "sidecar": true, "args": true }
      ]
    }
  ]
}
